{
  "name": "ojt-hours-tracker",
  "version": "1.0.0",
  "description": "OJT hours tracker with Node.js + Firebase backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "functions:serve": "cd functions && npm run serve",
    "functions:deploy": "firebase deploy --only functions",
    "functions:logs": "firebase functions:log",
    "deploy": "firebase deploy",
    "deploy:hosting": "firebase deploy --only hosting",
    "deploy:all": "firebase deploy --only hosting,functions"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^13.8.0",
    "firebase-functions": "^7.2.5",
    "mysql2": "^3.11.3"
  }
}
