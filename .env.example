PORT=3000

# Firebase Configuration
# Get these from your Firebase Console
# Project Settings > Service Accounts > Generate Private Key

# Optional project ID override if the service account does not include one
# FIREBASE_PROJECT_ID=ojt-tracker-bf9ba

# Option 1: Point to service account JSON file
# FIREBASE_KEY_PATH=./service-account.json

# Option 2: Paste entire JSON as environment variable
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Firebase Realtime Database URL (optional)
# FIREBASE_DATABASE_URL=https://your-project.firebaseio.com

